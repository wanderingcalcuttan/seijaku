generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum CategoryKind {
  SHOP_BRIDGE
  PROGRAM
  RETREAT
}

enum ProductStatus {
  IN_STOCK
  LIMITED_EDITION
  UPCOMING
  OPEN_FOR_BOOKING
  SOLD_OUT
  WAITLIST
  BOOKING_OPEN
}

enum ProductWorkflowStatus {
  DRAFT
  PUBLISHED
}

enum ProductMediaType {
  PRIMARY
  GALLERY
  DETAIL
  VIDEO_POSTER
}

enum TagKind {
  RITUAL
  MATERIAL
  STORY
  CAMPAIGN
}

enum SelectionMode {
  SINGLE
  MULTI
}

enum CollectionKind {
  CORE_COLLECTION
  SEASONAL_DROP
  HEMANTA
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum ProgramStatus {
  DRAFT
  UPCOMING
  BOOKING_OPEN
  CLOSED
}

enum ProgramSessionStatus {
  UPCOMING
  BOOKING_OPEN
  FULL
  CLOSED
  CANCELLED
}

enum RetreatStatus {
  DRAFT
  UPCOMING
  INQUIRY_OPEN
  CLOSED
}

enum SeasonalDropStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum LeadStatus {
  NEW
  REVIEWED
  CONTACTED
  CLOSED
}

enum NewsletterStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

model Admin {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  role         AdminRole   @default(EDITOR)
  status       AdminStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Customer {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String?
  phone               String?
  status              CustomerStatus       @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  orderRequests       OrderRequest[]
  programReservations ProgramReservation[]
  retreatInquiries    RetreatInquiry[]
  wishlistItems       WishlistItem[]
  ritualEntries       RitualEntry[]
  productNotifications ProductNotification[]
}

model MediaAsset {
  id               String           @id @default(cuid())
  url              String           @unique
  altText          String?
  kind             MediaKind        @default(IMAGE)
  width            Int?
  height           Int?
  createdAt        DateTime         @default(now())
  primaryProducts  Product[]        @relation("PrimaryProductImage")
  productMedia     ProductMedia[]
  articleImages    Article[]        @relation("ArticlePrimaryImage")
  retreatImages    Retreat[]        @relation("RetreatPrimaryImage")
  siteSettingsLogo SiteSetting[]    @relation("SiteLogoImage")
}

model ProductCategory {
  id          String                      @id @default(cuid())
  slug        String                      @unique
  name        String
  kind        CategoryKind
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  memberships ProductCategoryMembership[]
}

model Product {
  id               String                      @id @default(cuid())
  slug             String                      @unique
  title            String
  shortDescription String?
  longDescription  String?
  type             String
  material         String
  useCase          String?
  priceAmount      Int
  currency         String                      @default("INR")
  status           ProductStatus               @default(IN_STOCK)
  workflowStatus   ProductWorkflowStatus       @default(DRAFT)
  releaseDate      DateTime?
  seoTitle         String?
  seoDescription   String?
  imageAlt         String?
  ctaLabel         String?
  metadataJson     Json?
  primaryImageId   String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  publishedAt      DateTime?
  primaryImage     MediaAsset?                 @relation("PrimaryProductImage", fields: [primaryImageId], references: [id], onDelete: SetNull)
  media            ProductMedia[]
  categories       ProductCategoryMembership[]
  tagLinks         ProductTagLink[]
  options          ProductOption[]
  collections      CollectionProductLink[]
  bridgePages      ShopBridgePageProduct[]
  orderItems       OrderRequestItem[]
  wishlistItems    WishlistItem[]
  notifications    ProductNotification[]
}

model ProductMedia {
  id           String           @id @default(cuid())
  productId    String
  mediaAssetId String
  sortOrder    Int              @default(0)
  mediaType    ProductMediaType @default(GALLERY)
  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset       @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([productId, mediaAssetId, mediaType, sortOrder])
}

model ProductCategoryMembership {
  id         String          @id @default(cuid())
  productId  String
  categoryId String
  sortOrder  Int             @default(0)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
}

model ProductTag {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  kind      TagKind
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  links     ProductTagLink[]
}

model ProductTagLink {
  id        String     @id @default(cuid())
  productId String
  tagId     String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       ProductTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
}

model ProductOption {
  id            String               @id @default(cuid())
  productId     String
  code          String
  label         String
  selectionMode SelectionMode        @default(SINGLE)
  required      Boolean              @default(false)
  sortOrder     Int                  @default(0)
  metadataJson  Json?
  product       Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values        ProductOptionValue[]

  @@unique([productId, code])
}

model ProductOptionValue {
  id               String         @id @default(cuid())
  productOptionId  String
  value            String
  label            String
  priceDeltaAmount Int            @default(0)
  sortOrder        Int            @default(0)
  isActive         Boolean        @default(true)
  productOption    ProductOption  @relation(fields: [productOptionId], references: [id], onDelete: Cascade)

  @@unique([productOptionId, value])
}

model Collection {
  id          String                  @id @default(cuid())
  slug        String                  @unique
  name        String
  description String?
  kind        CollectionKind
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  products    CollectionProductLink[]
}

model CollectionProductLink {
  id           String     @id @default(cuid())
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
}

model ShopBridgePage {
  id                         String                  @id @default(cuid())
  slug                       String                  @unique
  navLabel                   String
  heroEyebrow                String
  heroTitle                  String
  heroDescriptionJson        Json
  heroImage                  String                  @default("")
  heroImageAlt               String                  @default("")
  heroImagePosition          String?
  heroQuote                  String
  introEyebrow               String?
  introTitle                 String
  introDescription           String
  interludeImage             String?
  interludeImageAlt          String?
  productSectionEyebrow      String?
  productSectionTitle        String?
  productSectionDescription  String?
  postCtaTitle               String?
  postCtaDescription         String?
  postCtaPrimaryLabel        String?
  postCtaPrimaryHref         String?
  postCtaSecondaryLabel      String?
  postCtaSecondaryHref       String?
  seoTitle                   String?
  seoDescription             String?
  seoFootnote                String?
  contentJson                Json?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  products                   ShopBridgePageProduct[]
}

model ShopBridgePageProduct {
  id           String         @id @default(cuid())
  bridgePageId String
  productId    String
  sortOrder    Int            @default(0)
  bridgePage   ShopBridgePage @relation(fields: [bridgePageId], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([bridgePageId, productId])
}

model Article {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  category       String
  excerpt        String
  bodyMarkdown   String?
  featured       Boolean       @default(false)
  status         ArticleStatus @default(PUBLISHED)
  publishedAt    DateTime?
  primaryImageId String?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  primaryImage   MediaAsset?   @relation("ArticlePrimaryImage", fields: [primaryImageId], references: [id], onDelete: SetNull)
}

model Retreat {
  id                String            @id @default(cuid())
  slug              String            @unique
  name              String
  shortDescription  String
  detailDescription String
  location          String
  season            String
  format            String
  groupSize         String
  status            RetreatStatus     @default(UPCOMING)
  primaryImageId    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  primaryImage      MediaAsset?       @relation("RetreatPrimaryImage", fields: [primaryImageId], references: [id], onDelete: SetNull)
  inquiries         RetreatInquiry[]
}

model Program {
  id                String               @id @default(cuid())
  slug              String               @unique
  name              String
  shortDescription  String
  detailDescription String?
  durationLabel     String?
  groupSizeLabel    String?
  status            ProgramStatus        @default(UPCOMING)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  sessions          ProgramSession[]
  reservations      ProgramReservation[]
}

model ProgramSession {
  id             String               @id @default(cuid())
  programId      String
  startsAt       DateTime
  endsAt         DateTime
  timezone       String
  city           String
  venueName      String?
  capacity       Int
  spotsRemaining Int
  status         ProgramSessionStatus @default(UPCOMING)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  program        Program              @relation(fields: [programId], references: [id], onDelete: Cascade)
  reservations   ProgramReservation[]
}

model SeasonalDrop {
  id          String             @id @default(cuid())
  slug        String             @unique
  name        String
  description String?
  status      SeasonalDropStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model SiteSetting {
  id                 String      @id @default(cuid())
  key                String      @unique @default("default")
  footerEmail        String?
  footerPhone        String?
  addressLinesJson   Json?
  newsletterHeading  String?
  newsletterBody     String?
  miscJson           Json?
  logoImageId        String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  logoImage          MediaAsset? @relation("SiteLogoImage", fields: [logoImageId], references: [id], onDelete: SetNull)
}

model OrderRequest {
  id         String             @id @default(cuid())
  customerId String?
  email      String
  name       String
  phone      String?
  source     String?
  status     LeadStatus         @default(NEW)
  notes      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  customer   Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items      OrderRequestItem[]
}

model OrderRequestItem {
  id                  String       @id @default(cuid())
  orderRequestId      String
  productId           String
  quantity            Int          @default(1)
  unitPriceAmount     Int
  selectedOptionsJson Json?
  variantSummary      String?
  orderRequest        OrderRequest @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
  product             Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model NewsletterSubscription {
  id           String           @id @default(cuid())
  email        String           @unique
  source       String?
  status       NewsletterStatus @default(SUBSCRIBED)
  subscribedAt DateTime         @default(now())
}

model ProgramReservation {
  id               String          @id @default(cuid())
  programId        String
  programSessionId String?
  customerId       String?
  name             String
  email            String
  phone            String?
  participantCount Int             @default(1)
  notes            String?
  status           LeadStatus      @default(NEW)
  createdAt        DateTime        @default(now())
  program          Program         @relation(fields: [programId], references: [id], onDelete: Restrict)
  programSession   ProgramSession? @relation(fields: [programSessionId], references: [id], onDelete: SetNull)
  customer         Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
}

model RetreatInquiry {
  id         String      @id @default(cuid())
  retreatId  String
  customerId String?
  name       String
  email      String
  phone      String?
  partySize  Int         @default(1)
  notes      String?
  status     LeadStatus  @default(NEW)
  createdAt  DateTime    @default(now())
  retreat    Retreat     @relation(fields: [retreatId], references: [id], onDelete: Restrict)
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
}

model ProductNotification {
  id         String     @id @default(cuid())
  productId  String
  customerId String?
  email      String
  source     String?
  status     LeadStatus @default(NEW)
  notes      String?
  createdAt  DateTime   @default(now())
  notifiedAt DateTime?
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Idempotency: repeated Notify Me clicks for the same product+email upsert,
  // they don't create duplicate admin inbox rows.
  @@unique([productId, email])
  @@index([productId])
  @@index([email])
}

model RitualEntry {
  id            String   @id @default(cuid())
  customerId    String
  ritualType    String
  reflection    String?
  completedOn   DateTime
  streakSnapshot Int?
  createdAt     DateTime @default(now())
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}
