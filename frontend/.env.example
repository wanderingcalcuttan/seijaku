DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seijaku"
PAYMENT_CONFIG_ENCRYPTION_KEY="replace-with-base64-32-byte-key"

SEIJAKU_ADMIN_USERNAME="barnamala"
SEIJAKU_ADMIN_PASSWORD="replace-with-initial-admin-password"

RAZORPAY_KEY_ID="rzp_test_key"
RAZORPAY_SECRET_KEY="rzp_test_secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-razorpay-secret"

STRIPE_PUBLISHABLE_KEY="pk_test_key"
STRIPE_SECRET_KEY="sk_test_secret"
STRIPE_WEBHOOK_SECRET="replace-with-stripe-secret"

RECOMMENDATION_PROVIDER="none"
RECOMMENDATION_API_URL=""
RECOMMENDATION_API_KEY=""
RECOMMENDATION_MODEL=""

# Shared secret for POST /api/revalidate. Required. Generate with e.g.
# `openssl rand -base64 32`. Must match between the admin proxy caller and
# the revalidate endpoint — both live inside the same Next app, so one value.
REVALIDATE_SECRET=""

# Optional. Used by the admin proxy to resolve the self URL for internal
# revalidate calls. Falls back to VERCEL_URL, then the incoming request
# origin, so setting this is only needed if you run behind a proxy that
# rewrites the origin.
SITE_URL=""
